+/// ArchHub: the app's own MCP endpoint is a default extension. ArchHub sets ARCHHUB_MCP_URL to its
+/// loopback server when it starts BABOOM's engine; only a 127.0.0.1 http URL is accepted.
+pub const ARCHHUB_EXTENSION: &str = "archhub";
+
+fn with_archhub(mut extensions: Vec<ExtensionConfig>) -> Vec<ExtensionConfig> {
+    let uri = std::env::var("ARCHHUB_MCP_URL").unwrap_or_default();
+    let present = extensions
+        .iter()
+        .any(|ext| ext.name() == ARCHHUB_EXTENSION);
+    if uri.starts_with("http://127.0.0.1:") && !present {
+        extensions.push(ExtensionConfig::streamable_http(
+            ARCHHUB_EXTENSION.to_string(),
+            uri,
+            "ArchHub: the user's programs, canvas and Workshop".to_string(),
+            DEFAULT_EXTENSION_TIMEOUT,
+        ));
+    }
+    extensions
 }
 
