{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArchHub session v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "title",
    "nodes",
    "wires",
    "groups",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "archhub"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "title": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "params",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object"
          },
          "position": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "item": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parent": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "wires": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "object",
            "required": [
              "node",
              "socket"
            ],
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1
              },
              "socket": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "to": {
            "type": "object",
            "required": [
              "node",
              "socket"
            ],
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1
              },
              "socket": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "rule": {
            "type": "string"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nodes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      }
    },
    "viewport": {
      "type": "object",
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      }
    },
    "properties": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "maxLength": 128,
          "description": "Registered workspace root_id (settings/workspaces.json owns its label)."
        },
        "state": {
          "enum": ["open", "done", "archived"]
        },
        "pinned": {
          "type": "boolean"
        },
        "doneCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {"type": "string", "minLength": 1, "maxLength": 2000},
            "node": {"type": "string", "minLength": 1},
            "tries": {"type": "integer", "minimum": 0},
            "blocked": {"type": "boolean"},
            "lastError": {"type": "string"}
          },
          "oneOf": [{"required": ["command"]}, {"required": ["node"]}]
        },
        "settings": {
          "type": "object",
          "description": "Session overrides keyed by Settings row id; the global value stays with its owner.",
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        },
        "inputLinks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["source", "output", "input"],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "object",
                "required": ["path", "id"],
                "additionalProperties": false,
                "properties": {
                  "path": {"type": "string", "pattern": "^(?![A-Za-z]:|[\\\\/]).*\\.archhub$"},
                  "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}
                }
              },
              "output": {"type": "string", "minLength": 1, "maxLength": 128},
              "input": {"type": "string", "minLength": 1, "maxLength": 128},
              "rule": {"type": "string", "maxLength": 4096}
            }
          }
        }
      }
    }
  }
}
