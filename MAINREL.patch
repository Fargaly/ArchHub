+function Add-RunnerFixture($Journal) {
+    $source = [IO.Path]::GetFullPath($Journal)
+    if (-not $source.StartsWith($guestLocal+'\',[StringComparison]::OrdinalIgnoreCase)) { throw 'Fixture source is outside the disposable profile.' }
