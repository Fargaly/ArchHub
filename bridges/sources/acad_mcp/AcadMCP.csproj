<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Default targets AutoCAD 2025+. Installer overrides for 2024 (net48). -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>AcadMCP</AssemblyName>
    <RootNamespace>AcadMCP</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- AgDR-0029 — deterministic build for SHA-256 manifest gate. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

  <PropertyGroup>
    <AcadInstallDir Condition="'$(AcadInstallDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AcadInstallDir>
    <AcadYear Condition="'$(AcadYear)' == ''">2025</AcadYear>
    <UseLocalAcadApi Condition="Exists('$(AcadInstallDir)\acmgd.dll')">true</UseLocalAcadApi>
    <UseLocalAcadApi Condition="'$(UseLocalAcadApi)' == ''">false</UseLocalAcadApi>
  </PropertyGroup>

  <!-- Local AutoCAD install: reference its DLLs directly. -->
  <ItemGroup Condition="'$(UseLocalAcadApi)' == 'true'">
    <Reference Include="acmgd">
      <HintPath>$(AcadInstallDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadInstallDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadInstallDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- CI / clean machine: NuGet AutoCAD.NET package — Autodesk's
       official redistribution of the managed AutoCAD API. Its versions
       follow the release series (2025 = R25.0, 2026 = R25.1, 2027 = R26.0),
       so each year is pinned EXACTLY here (nuget.org AutoCAD.NET listing,
       2026-09-28); no floating range, no version derived from the year.
       A year without a pin fails the build instead of guessing. -->
  <PropertyGroup Condition="'$(UseLocalAcadApi)' == 'false'">
    <AcadPackageVersion Condition="'$(AcadYear)' == '2020'">23.1.0</AcadPackageVersion>
    <AcadPackageVersion Condition="'$(AcadYear)' == '2021'">24.0.0</AcadPackageVersion>
    <AcadPackageVersion Condition="'$(AcadYear)' == '2022'">24.1.51000</AcadPackageVersion>
    <AcadPackageVersion Condition="'$(AcadYear)' == '2023'">24.2.0</AcadPackageVersion>
    <AcadPackageVersion Condition="'$(AcadYear)' == '2024'">24.3.0</AcadPackageVersion>
    <AcadPackageVersion Condition="'$(AcadYear)' == '2025'">25.0.2</AcadPackageVersion>
    <AcadPackageVersion Condition="'$(AcadYear)' == '2026'">25.1.1</AcadPackageVersion>
    <AcadPackageVersion Condition="'$(AcadYear)' == '2027'">26.0.0</AcadPackageVersion>
  </PropertyGroup>
  <Target Name="RequireExactAcadPackagePin" BeforeTargets="CollectPackageReferences;Restore;_GenerateRestoreGraph"
          Condition="'$(UseLocalAcadApi)' == 'false' And '$(AcadPackageVersion)' == ''">
    <Error Text="No exact AutoCAD.NET pin for AutoCAD $(AcadYear); add one to AcadMCP.csproj after review." />
  </Target>
  <ItemGroup Condition="'$(UseLocalAcadApi)' == 'false' And '$(AcadPackageVersion)' != ''">
    <PackageReference Include="AutoCAD.NET"
                      Version="[$(AcadPackageVersion)]"
                      ExcludeAssets="runtime"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- AgDR-0025 — shared subprocess csc.exe wrapper.  Linked from
       payload/sources/shared so the same Roslyn-isolation impl powers
       every .NET connector. -->
  <ItemGroup>
    <Compile Include="..\shared\ScriptCompiler.cs"
             Link="ScriptCompiler.cs" />
    <!-- Caller check on /exec and /info (bridges/sources/shared/BridgeAuth.cs). -->
    <Compile Include="..\shared\BridgeAuth.cs"
             Link="BridgeAuth.cs" />
  </ItemGroup>

  <!-- AgDR-0025 — Microsoft.CodeAnalysis* package reference REMOVED.
       Compilation now happens out-of-process via csc.exe (see
       ScriptCompiler.cs).  Eliminates the whole class of "AutoCAD
       add-in pinned Roslyn vX, we want vY → FileLoadException".
       System.Text.Json kept — /info still serializes JSON. -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
