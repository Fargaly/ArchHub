#!/usr/bin/env bash
# Pre-push guard for ArchHub local safety gates.
#
# This is a second line of defense if pre-commit was bypassed. It checks the
# commits introduced by the push, not the current working tree.

set -euo pipefail

remote="${1:-}"
url="${2:-}"
_unused_remote="$remote"
_unused_url="$url"

if [[ "${ARCHHUB_ALLOW_CS_EDIT:-0}" == "1" ]]; then
    exit 0
fi

introduced_range_args() {
    local local_sha="$1"
    local remote_sha="$2"
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        local base
        base=$(git rev-parse --verify --quiet refs/remotes/origin/main || true)
        if [[ -n "$base" ]]; then
            printf '%s\n' "$base..$local_sha"
        else
            printf '%s\n' "-50"
            printf '%s\n' "$local_sha"
        fi
    else
        printf '%s\n' "$remote_sha..$local_sha"
    fi
}

PYTHON_BIN="${ARCHHUB_PYTHON:-python}"

while read -r local_ref local_sha remote_ref remote_sha; do
    local_ref="${local_ref//$'\r'/}"
    local_sha="${local_sha//$'\r'/}"
    remote_ref="${remote_ref//$'\r'/}"
    remote_sha="${remote_sha//$'\r'/}"
    if [[ -z "${local_sha:-}" ]]; then
        continue
    fi
    if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
        continue
    fi

    mapfile -t range_args < <(introduced_range_args "$local_sha" "$remote_sha")

    cs_changes=$(git log --name-only --pretty=format: "${range_args[@]}" -- \
                 ':(glob)payload/sources/**/*.cs' 2>/dev/null | sort -u | grep -v '^$' || true)
    if [[ -n "$cs_changes" ]]; then
        cat >&2 <<EOF
================================================================
  PUSH BLOCKED - $local_ref carries broker .cs edits
================================================================
Files touched in commits being pushed:
$(echo "$cs_changes" | sed 's/^/  /')

Broker source files require an AgDR and founder sign-off.
Bypass with explicit founder approval:
  ARCHHUB_ALLOW_CS_EDIT=1 git push ...
================================================================
EOF
        exit 1
    fi

    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        runtime_changes=$(git log --name-only --pretty=format: "${range_args[@]}" -- \
                          node_runtime 2>/dev/null | sort -u | grep -v '^$' || true)
    else
        runtime_changes=$(git diff --name-only "$remote_sha..$local_sha" -- \
                          node_runtime 2>/dev/null | sort -u | grep -v '^$' || true)
    fi
    if [[ -n "$runtime_changes" ]]; then
        if ! command -v "$PYTHON_BIN" >/dev/null 2>&1 && [ ! -f "$PYTHON_BIN" ]; then
            echo "[runtime-retirement-gate] python unavailable; blocking node_runtime push." >&2
            exit 1
        fi
        if [ ! -f tools/legacy_runtime_drain.py ]; then
            echo "[runtime-retirement-gate] tools/legacy_runtime_drain.py missing; blocking node_runtime push." >&2
            exit 1
        fi
        GATE_RC=0
        "$PYTHON_BIN" tools/legacy_runtime_drain.py --no-write --enforce-retirement-gate >/dev/null || GATE_RC=$?
        if [ "$GATE_RC" != "0" ]; then
            cat >&2 <<EOF
================================================================
  PUSH BLOCKED - node_runtime retirement gate is red
================================================================
Pushed commits touch node_runtime/:
$(echo "$runtime_changes" | sed 's/^/  /')

Run:
  python tools/legacy_runtime_drain.py --no-write --enforce-retirement-gate

Then inspect the retirement_gate failures before pushing node_runtime changes.
================================================================
EOF
            exit 1
        fi
    fi
done

# Brain commit gate parity. This remains warn/fail-open by default and only
# blocks when the gate deliberately exits 1.
if command -v "$PYTHON_BIN" >/dev/null 2>&1 && [ -f tools/brain_commit_gate.py ]; then
    GATE_RC=0
    "$PYTHON_BIN" tools/brain_commit_gate.py || GATE_RC=$?
    if [ "$GATE_RC" = "1" ]; then
        exit 1
    fi
else
    echo "[brain-commit-gate] python or gate script unavailable; fail-open, not blocking." >&2
fi

exit 0
