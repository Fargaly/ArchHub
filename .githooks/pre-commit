#!/usr/bin/env bash
# Pre-commit guard for ArchHub local safety gates.
#
# This hook is intentionally local. CI/server-side protection still has to be
# verified separately. Keep each gate narrow so normal commits are not blocked
# by unrelated live runtime state.

set -euo pipefail

if [[ "${ARCHHUB_ALLOW_CS_EDIT:-0}" == "1" ]]; then
    exit 0
fi

# Broker .cs guard: these files control host MCP brokers and require founder
# sign-off before commit.
STAGED_CS=$(git diff --cached --name-only --diff-filter=ACMR \
            -- ':(glob)payload/sources/**/*.cs' 2>/dev/null || true)

if [[ -n "$STAGED_CS" ]]; then
    cat >&2 <<'EOF'
================================================================
  COMMIT BLOCKED - payload/sources/**/*.cs edit detected
================================================================
Broker source files require an AgDR and founder sign-off.

Staged broker source files:
EOF
    echo "$STAGED_CS" | sed 's/^/  /' >&2
    cat >&2 <<'EOF'

If you have explicit founder sign-off:
  ARCHHUB_ALLOW_CS_EDIT=1 git commit -m "..."

To inspect:
  git diff --cached -- payload/sources/**/*.cs
================================================================
EOF
    exit 1
fi

# Universal Cell runtime-copy retirement gate.
# Fires only when a commit stages changes under node_runtime/. A staged
# archive/removal/edit of the copied runtime must prove the machine-readable
# retirement gate is green.
STAGED_NODE_RUNTIME=$(git diff --cached --name-only --diff-filter=ACMRD \
            -- node_runtime 2>/dev/null || true)

if [[ -n "$STAGED_NODE_RUNTIME" ]]; then
    PYTHON_BIN="${ARCHHUB_PYTHON:-python}"
    if ! command -v "$PYTHON_BIN" >/dev/null 2>&1 && [ ! -f "$PYTHON_BIN" ]; then
        echo "[runtime-retirement-gate] python unavailable; blocking node_runtime retirement." >&2
        exit 1
    fi
    if [ ! -f tools/legacy_runtime_drain.py ]; then
        echo "[runtime-retirement-gate] tools/legacy_runtime_drain.py missing; blocking node_runtime retirement." >&2
        exit 1
    fi
    GATE_RC=0
    "$PYTHON_BIN" tools/legacy_runtime_drain.py --no-write --enforce-retirement-gate >/dev/null || GATE_RC=$?
    if [ "$GATE_RC" != "0" ]; then
        cat >&2 <<'EOF'
================================================================
  COMMIT BLOCKED - node_runtime retirement gate is red
================================================================
Staged changes touch node_runtime/. The copied runtime may only be
archived or removed after:
  - live holder count is zero,
  - Universal Cell authority launch readiness is green,
  - exact authority replacements are not blocked,
  - the non-interrupting handoff schedule has been completed.

Run:
  python tools/legacy_runtime_drain.py --no-write --enforce-retirement-gate

Then inspect the retirement_gate failures before trying this commit again.
================================================================
EOF
        exit 1
    fi
fi

# Brain commit gate. This remains warn/fail-open by default and only blocks
# when the gate itself deliberately exits 1.
PYTHON_BIN="${ARCHHUB_PYTHON:-python}"
if command -v "$PYTHON_BIN" >/dev/null 2>&1 && [ -f tools/brain_commit_gate.py ]; then
    GATE_RC=0
    "$PYTHON_BIN" tools/brain_commit_gate.py || GATE_RC=$?
    if [ "$GATE_RC" = "1" ]; then
        exit 1
    fi
else
    echo "[brain-commit-gate] python or gate script unavailable; fail-open, not blocking." >&2
fi

exit 0
