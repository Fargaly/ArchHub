+'@
+    $app = Join-Path $guestLocal 'ArchHub'
+    & (Join-Path $app '.venv\Scripts\python.exe') -I -B -c $paddingCode $source $target | Tee-Object -FilePath (Join-Path $out 'fixture-padding.log') | ForEach-Object { Write-Host $_ }
