+import sys
+from pathlib import Path
+
+HOOKS = Path(__file__).resolve().parents[1] / '03.AGENT-HOOKS'
+sys.path.insert(0, str(HOOKS))
+import pretooluse_validate as gate
+
+
+def test_child_stop_ignores_office_data():
+    command = "python -c \"import subprocess; import sys; data='excel'; child=subprocess.Popen([sys.executable, '-c', 'pass'], stdout=subprocess.DEVNULL, creationflags=subprocess.CREATE_NO_WINDOW); child.kill()\""
+    assert gate._command_denial(command, str(Path.cwd()), "codex", False) is None
+
+
+def test_unknown_stop_ownership_refuses():
+    assert gate._dialect_denial('python -c "child.kill()"', str(Path.cwd()), "codex", False, True)
+
+
+def test_app_name_and_imagewide_stops_refuse():
+    for command in ('Stop-Process -Name Excel', 'Get-Process Excel | % { $_.Kill() }',
+                    'taskkill /IM python.exe', 'python -c "import subprocess; p=subprocess.Popen([\'excel.exe\']); p.kill()"'):
+        assert gate._dialect_denial(command, str(Path.cwd()), "codex", False, True)
+
+
+def test_rebound_child_refuses():
+    command = 'python -c "import subprocess; import sys; p=subprocess.Popen([sys.executable]); p=other; p.kill()"'
+    assert gate._dialect_denial(command, str(Path.cwd()), "codex", False, True)
+
+
+def test_all_stops_are_checked_including_assignment_values_and_later_commands():
+    prefix = "import subprocess; import sys; p=subprocess.Popen([sys.executable]); p.kill(); "
+    for tail in ('q.kill()', 'x=q.kill()', 'p=other; p.kill()', 'p.kill(); q.kill()'):
+        command = 'python -c "' + prefix + tail + '"'
+        assert gate._dialect_denial(command, str(Path.cwd()), "codex", False, True)
+    command = 'python -c "' + prefix + '"; Get-Process Excel | % { $_.Kill() }'
+    assert gate._dialect_denial(command, str(Path.cwd()), "codex", False, True)
+
+
+def test_unknown_and_overridden_executable_refuses():
+    for arguments in ("[name]", "[sys.executable], executable='excel.exe'", "['cmd'], shell=True"):
+        command = 'python -c "import subprocess; import sys; p=subprocess.Popen(' + arguments + '); p.kill()"'
+        assert gate._dialect_denial(command, str(Path.cwd()), "codex", False, True)
+
+
+def test_rebinding_inside_an_expression_refuses():
+    command = 'python -c "import subprocess; import sys; p=subprocess.Popen([sys.executable]); (p:=other).kill()"'
+    assert gate._command_denial(command, str(Path.cwd()), "codex", False)
+
+
+def test_unknown_factory_ownership_refuses():
+    for prefix in ('', 'import subprocess; subprocess=other; '):
+        command = 'python -c "' + prefix + "p=subprocess.Popen(['child.exe']); p.kill()" + '"'
+        assert gate._command_denial(command, str(Path.cwd()), "codex", False)
